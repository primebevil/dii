<?xml version="1.0" encoding="UTF-8"?>
<!--
  The macOS equivalent of dii-node.service: launchd keeps the node running and
  restarts it if it exits. This is the right choice on a Mac, where Ollama has to
  run natively anyway (a container cannot reach the GPU).

    cp com.dii.node.plist ~/Library/LaunchAgents/
    launchctl load  ~/Library/LaunchAgents/com.dii.node.plist
    launchctl list | grep com.dii.node
    launchctl unload ~/Library/LaunchAgents/com.dii.node.plist   # to stop

  Edit the two paths below for your machine. launchd sends SIGTERM on unload, so
  the node's own drain applies exactly as it does under systemd or Docker.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dii.node</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/dii-node</string>
    </array>

    <!-- The config path comes from the environment, so the agent is not tied to
         a working directory. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>DII_CONFIG</key>
        <string>/usr/local/etc/dii/config.yaml</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- One JSON accounting line per request goes to stdout; send it somewhere
         readable. -->
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/dii-node.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/dii-node.log</string>
</dict>
</plist>
